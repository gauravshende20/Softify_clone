# Copy to secret.yaml and fill from a secret manager. Do not commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: harmonia-secrets
  namespace: harmonia
type: Opaque
stringData:
  JWT_SECRET: "replace-with-256-bit-secret"
  DB_USERNAME: "harmonia"
  DB_PASSWORD: "replace-me"
  MINIO_ACCESS_KEY: "replace-me"
  MINIO_SECRET_KEY: "replace-me"
  MAIL_USERNAME: ""
  MAIL_PASSWORD: ""
  ADMIN_BOOTSTRAP_PASSWORD: "replace-me"
  # Stripe test/live secret key and the webhook signing secret. Never expose these to the browser.
  STRIPE_SECRET_KEY: "sk_test_replace-me"
  STRIPE_WEBHOOK_SECRET: "whsec_replace-me"
